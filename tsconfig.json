{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Desligados durante a migração: o código portado do LocalDrawDB foi escrito sob
    // um tsconfig mais frouxo, e satisfazer essas duas flags exigiria EDITAR código
    // verbatim — a única coisa que não pode acontecer. Reativar depois do Stage 6,
    // como limpeza própria. Até lá, @typescript-eslint/no-unused-vars cobre código
    // novo via npm run lint.
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
