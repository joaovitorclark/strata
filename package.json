{
  "name": "strata",
  "version": "0.1.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && vite build",
    "build:win": "node scripts/build-win/build.mjs",
    "test:watch": "vitest",
    "dev:server": "tsx watch server/index.ts",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "e2e:serve": "node scripts/e2e-serve.mjs",
    "cy:open": "cypress open",
    "cy:run": "cypress run --spec 'cypress/e2e/!(stress-)*.cy.ts'",
    "cy:run:stress": "cypress run --config-file cypress.stress.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaovitorclark/strata.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/joaovitorclark/strata/issues"
  },
  "homepage": "https://github.com/joaovitorclark/strata#readme",
  "private": "true",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
